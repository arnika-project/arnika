FROM golang:1.26-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=0
ENV GOEXPERIMENT=runtimesecret

ARG BUILD_TAGS=""
RUN go build -tags="${BUILD_TAGS}" -o /arnika .

FROM alpine:latest

RUN apk add --no-cache \
  bash \
  wireguard-tools \
  iproute2 \
  iputils \
  curl \
  jq

COPY --from=builder /arnika /usr/local/bin/arnika

CMD ["sleep", "infinity"]
